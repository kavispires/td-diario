{
  "name": "td-diario",
  "private": true,
  "version": "0.0.1",
  "homepage": "https://diario.kavispires.com",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "prepare": "husky",
    "preview": "vite preview",
    "deploy": "yarn build && gh-pages -d dist",
    "clean": "rm -rf node_modules && yarn cache clean"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "firebase": "^12.18.0",
    "lucide-react": "^1.41.0",
    "motion": "^13.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@tailwindcss/vite": "^4.3.3",
    "@types/gh-pages": "^6",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,json,jsonc,css,svg,html}": "biome check --write"
  }
}
